# Frontend Environment Variables

# API URL (change this to your backend URL in production)
VITE_API_URL=https://moneymate-backend-oclv.onrender.com

# Frontend URL (for production deployment)
VITE_FRONTEND_URL=https://moneymate-frontend-oclv.onrender.com

# Optional: Enable debug mode
VITE_DEBUG=false

# Backend Environment Variables (for Render deployment)
# DATABASE_URL should be set in Render dashboard for external PostgreSQL database
# Format: postgresql+psycopg2://user:password@host:port/database
# Example: postgresql+psycopg2://moneymate_user:password@external-db-host.com:5432/moneymate
